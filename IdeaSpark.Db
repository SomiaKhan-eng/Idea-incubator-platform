-- 🚀 IdeaSpark: Database Schema
-- Project: AR-Powered Idea Incubator Platform

-- 1. Create and Select Database
DROP DATABASE IF EXISTS IdeaSparkDB;
CREATE DATABASE IdeaSparkDB;
USE IdeaSparkDB;

-- ==========================================
-- 2. TABLE CREATION
-- ==========================================

-- Table: USERS (Core Identity)
-- Handles Creators, Investors, and Mentors
CREATE TABLE Users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role ENUM('Creator', 'Investor', 'Mentor', 'Admin') DEFAULT 'Creator',
    bio TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Table: IDEAS (The Core Content)
-- Stores the startup concepts
CREATE TABLE Ideas (
    idea_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT, -- The Creator
    title VARCHAR(100) NOT NULL,
    description TEXT,
    category ENUM('Tech', 'Art', 'Business', 'Social', 'Health') DEFAULT 'Tech',
    funding_goal DECIMAL(15, 2) DEFAULT 0.00,
    current_funding DECIMAL(15, 2) DEFAULT 0.00,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES Users(user_id) ON DELETE CASCADE
);

-- Table: INVESTMENTS (The Money)
-- Tracks who invested in what idea
CREATE TABLE Investments (
    investment_id INT AUTO_INCREMENT PRIMARY KEY,
    investor_id INT, -- Must be a user with role 'Investor'
    idea_id INT,
    amount DECIMAL(15, 2) NOT NULL,
    investment_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (investor_id) REFERENCES Users(user_id),
    FOREIGN KEY (idea_id) REFERENCES Ideas(idea_id) ON DELETE CASCADE
);

-- Table: MENTORSHIP_SESSIONS (The AI & Human Help)
-- Tracks interactions between Mentors/AI and Creators
CREATE TABLE MentorshipSessions (
    session_id INT AUTO_INCREMENT PRIMARY KEY,
    mentor_id INT, -- Can be a human mentor or NULL for AI
    creator_id INT,
    session_type ENUM('AI_Chat', 'Human_Video', 'Code_Review') DEFAULT 'AI_Chat',
    notes TEXT,
    session_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (creator_id) REFERENCES Users(user_id)
);
-- 1. Create Teams Table [cite: 43, 215]
CREATE TABLE Teams (
    team_id INT AUTO_INCREMENT PRIMARY KEY,
    team_name VARCHAR(100) NOT NULL,
    create_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    visibility ENUM('Public', 'Private') DEFAULT 'Public' 
);
CREATE TABLE Votes (
    vote_id INT AUTO_INCREMENT PRIMARY KEY,
    idea_id INT NOT NULL,
    user_id INT NOT NULL,
    vote_type ENUM('Upvote', 'Downvote') NOT NULL,
    UNIQUE KEY unique_vote (idea_id, user_id), -- Aik banda aik hi baar vote kar sake
    FOREIGN KEY (idea_id) REFERENCES Ideas(idea_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES Users(user_id) ON DELETE CASCADE
);
CREATE TABLE TeamRequests (
    request_id INT PRIMARY KEY AUTO_INCREMENT,
    idea_id INT,
    user_id INT, -- Jo join karna chahta hai (Collaborator)
    status ENUM('Pending', 'Accepted', 'Rejected') DEFAULT 'Pending',
    request_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (idea_id) REFERENCES Ideas(idea_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES Users(user_id) ON DELETE CASCADE
);
-- 2. Create Many-to-Many Membership Table [cite: 49, 112]
CREATE TABLE Team_Members (
    team_id INT,
    user_id INT,
    role_in_team VARCHAR(50) DEFAULT 'Member',
    PRIMARY KEY (team_id, user_id),
    FOREIGN KEY (team_id) REFERENCES Teams(team_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES Users(user_id) ON DELETE CASCADE
);

-- 3. Create SessionContext Table for AR Adaptation [cite: 78, 81]
CREATE TABLE SessionContext (
    context_id INT AUTO_INCREMENT PRIMARY KEY,
    idea_id INT, -- Linking context to the Idea/Workspace [cite: 84]
    lighting_level DECIMAL(5,2),
    noise_level DECIMAL(5,2),
    activity_status VARCHAR(50),
    adaptation_action VARCHAR(255),
    captured_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (idea_id) REFERENCES Ideas(idea_id) ON DELETE CASCADE
);
CREATE TABLE Feedback (
    feedback_id INT AUTO_INCREMENT PRIMARY KEY,
    idea_id INT,
    user_id INT,
    comment_text TEXT,
    rating INT CHECK (rating >= 1 AND rating <= 5),
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (idea_id) REFERENCES Ideas(idea_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);


